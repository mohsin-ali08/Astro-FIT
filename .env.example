# --- Astro FIT Environment Variables ---
# Optional: Google Gemini API key for the Flight Surgeon Co-Pilot.
# If omitted, the app automatically uses its onboard offline NASA HRP knowledge base.
GEMINI_API_KEY="your_gemini_api_key"

# Public base URL of the application
APP_URL="http://localhost:3000"

# Backend port (defaults to 3000)
# PORT=3000
